# ═══════════════════════════════════════════════════════════
# AI Trading Bot v2.0 - Configuration
# Polymarket Prediction Market Arbitrage
# ═══════════════════════════════════════════════════════════

# ─── Polymarket CLOB API (Required) ──────────────────────
# Get credentials at: https://docs.polymarket.com
POLYMARKET_API_KEY=your_api_key_here
POLYMARKET_API_SECRET=your_api_secret_here
POLYMARKET_API_PASSPHRASE=your_passphrase_here
POLYMARKET_PRIVATE_KEY=your_polygon_wallet_private_key
# POLYMARKET_FUNDER_ADDRESS=your_proxy_wallet_address

# ─── Odds Providers (at least one required) ──────────────
# The Odds API (basic, $30-200/mo) - https://the-odds-api.com
ODDS_API_KEY=your_odds_api_key_here

# SharpAPI (Pinnacle sharp lines, arb detection, $79-399/mo) - https://sharpapi.io
# SHARP_API_KEY=your_sharp_api_key

# Odds-API.io (265 books, WebSocket, arb endpoint) - https://odds-api.io
# ODDS_API_IO_KEY=your_odds_api_io_key

# Sportradar (official league data, injuries, $500-5K/mo) - https://sportradar.com
# SPORTRADAR_API_KEY=your_sportradar_key

# ─── AI Models (at least one required) ──────────────────
# Claude (Anthropic) - https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# CLAUDE_MODEL=claude-sonnet-4-6

# GPT-4o (OpenAI) - https://platform.openai.com
# OPENAI_API_KEY=your_openai_key
# GPT_MODEL=gpt-4o

# Google Gemini - https://ai.google.dev
# GOOGLE_AI_KEY=your_google_key
# GEMINI_MODEL=gemini-1.5-pro

# Ensemble weights (must sum to 1.0)
# ENSEMBLE_WEIGHT_CLAUDE=0.40
# ENSEMBLE_WEIGHT_GPT=0.35
# ENSEMBLE_WEIGHT_GEMINI=0.25
# EXTREMIZATION_FACTOR=1.5

# ─── Real-Time Data Feeds (Optional) ────────────────────
# Twitter/X API Pro ($5K/mo) - https://developer.twitter.com
# TWITTER_BEARER_TOKEN=your_twitter_bearer_token
# TWITTER_REPORTER_IDS=29233759,57466897  # Comma-separated reporter IDs

# Tomorrow.io Weather ($25-50/mo) - https://tomorrow.io
# TOMORROW_IO_KEY=your_tomorrow_key

# ─── Trading Configuration ──────────────────────────────
# DRY_RUN=true               # Paper trading (default: true)
# TOTAL_BUDGET=10000          # Total budget in USDC
# MAX_POSITION_SIZE=500       # Max single position USDC
# MIN_EDGE_PERCENT=2.0        # Minimum edge % to trade
# KELLY_FRACTION=0.25         # Kelly fraction (0.25 = quarter Kelly)
# SCAN_INTERVAL_MS=30000      # Scan interval in ms
# MARKET_MAKING=false         # Enable market making mode
# USE_WEBSOCKET=true          # Use WebSocket for real-time data
# NEWS_TRADING=true           # React to breaking news
# LOG_LEVEL=info              # debug|info|warn|error
